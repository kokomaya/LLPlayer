{
  "name": "aurora-player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected -t lint typecheck test",
    "test:boundaries": "vitest run tools/boundary-check",
    "cli": "tsx tools/cli/src/index.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "nx"
    ]
  },
  "devDependencies": {
    "@nx/eslint-plugin": "20.3.0",
    "@types/node": "20.19.0",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "nx": "20.3.0",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vitest": "2.1.8"
  }
}
