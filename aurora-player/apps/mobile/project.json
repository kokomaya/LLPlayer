{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "mobile",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "tags": ["scope:app"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings 0",
        "cwd": "apps/mobile"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "apps/mobile"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/mobile"
      }
    }
  }
}
