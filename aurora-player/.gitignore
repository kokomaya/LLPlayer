node_modules/
dist/
coverage/
.nx/
*.tsbuildinfo
.DS_Store
# transient reverse-example artifacts, if any
**/__boundary_violation__.ts

# Local demo media (downloaded/pushed to the emulator for on-device playback);
# not a repo input — see apps/mobile App.tsx notes.
/apps/mobile/.demo-assets/
/apps/mobile/.expo-export-test/

# Expo / React Native generated native projects — regenerated by `expo prebuild`
# (Continuous Native Generation). Kept out of git like the desktop's src-tauri/**
# thin binding; nothing here is a CI input. Delete these lines if you switch to a
# committed "bare" native workflow.
/apps/mobile/android/
/apps/mobile/ios/
.expo/

# Mobile/native signing secrets — MUST never be committed (rule ①.E).
# Covers Expo's generated debug.keystore and any future release keystore.
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

.npmrc
!packages/
!packages/**
**/node_modules/