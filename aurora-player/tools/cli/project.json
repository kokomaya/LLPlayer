{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "sourceRoot": "tools/cli/src",
  "projectType": "application",
  "tags": ["scope:tool"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings 0",
        "cwd": "tools/cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "tools/cli"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "tools/cli"
      }
    }
  }
}
