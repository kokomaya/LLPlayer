{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "player-api",
  "sourceRoot": "packages/player-api/src",
  "projectType": "library",
  "tags": ["scope:core", "layer:domain"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings 0",
        "cwd": "packages/player-api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "packages/player-api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/player-api"
      }
    }
  }
}
